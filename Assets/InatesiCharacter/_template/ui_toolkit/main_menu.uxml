<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:Template name="settings-panel" src="project://database/Assets/inatesi_mod/inatesi_mod/Assets/InatesiCharacter/_template/ui_toolkit/settings-panel.uxml?fileID=9197481963319205126&amp;guid=c77213c21533ab6489c35c8aba503e15&amp;type=3#settings-panel"/>
    <Style src="project://database/Assets/inatesi_mod/inatesi_mod/Assets/InatesiCharacter/_template/ui_toolkit/main_menu_style.uss?fileID=7433441132597879392&amp;guid=8d915bcf0fd683f40b954b7047aa5c43&amp;type=3#main_menu_style"/>
    <ui:VisualElement name="root-panel" style="flex-grow: 1; background-color: rgba(0, 0, 0, 0.922); background-image: none;">
        <ui:VisualElement name="buttons-panel" style="flex-grow: 1; width: 80%; align-self: center; justify-content: flex-start; top: auto; display: flex; align-items: center;">
            <ui:Label text="InatesI Mod" name="game-name" style="-unity-font-definition: url(&quot;project://database/Assets/inatesi_mod/inatesi_mod/Assets/InatesiCharacter/_template/fonts/CormorantInfant-VariableFont_wght.ttf?fileID=12800000&amp;guid=d1a3b84db50ba254995db5d2ada7834b&amp;type=3#CormorantInfant-VariableFont_wght&quot;); font-size: 122px; color: rgb(255, 255, 255); -unity-text-outline-width: 1px; -unity-text-outline-color: rgb(0, 0, 0); -unity-font-style: normal; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0;"/>
            <ui:Button text="continue" name="continue-button" class="button"/>
            <ui:Button text="save game" name="save-game-button" enabled="true" class="button" style="display: none;"/>
            <ui:Button text="load game" name="load-game-button" class="button" style="display: none;"/>
            <ui:Button text="settings" name="settings-button" class="button"/>
            <ui:Button text="exit" name="exit-button" class="button"/>
            <ui:Button text="change language" name="language-button" class="button"/>
        </ui:VisualElement>
        <ui:Instance template="settings-panel" style="display: none;"/>
    </ui:VisualElement>
    <ui:Button text="" name="open-menu" style="position: absolute; background-color: rgba(188, 188, 188, 0); border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; width: 55px; height: 55px;"/>
    <ui:Button text="&lt;" name="back-button" class="button" style="width: 100px; height: 100px; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; position: absolute; top: 50px; left: 50px; border-top-left-radius: 72px; border-top-right-radius: 72px; border-bottom-right-radius: 72px; border-bottom-left-radius: 72px; font-size: 59px; -unity-text-align: middle-center;"/>
    <ui:VisualElement name="loading-panel" style="flex-grow: 1; position: absolute; width: 100%; height: 100%; background-color: rgb(0, 0, 0);">
        <ui:Label text="99%" name="loading-progress-text" style="position: absolute; align-self: center; bottom: 50%; font-size: 67px; -unity-font-definition: url(&quot;project://database/Assets/inatesi_mod/inatesi_mod/Assets/InatesiCharacter/_template/fonts/CormorantInfant-VariableFont_wght.ttf?fileID=12800000&amp;guid=d1a3b84db50ba254995db5d2ada7834b&amp;type=3#CormorantInfant-VariableFont_wght&quot;); color: rgb(255, 255, 255); border-top-width: 1px; border-right-width: 1px; border-bottom-width: 1px; border-left-width: 1px; border-left-color: rgb(255, 255, 255); border-right-color: rgb(255, 255, 255); border-top-color: rgb(255, 255, 255); border-bottom-color: rgb(255, 255, 255); border-top-left-radius: 312px; border-top-right-radius: 312px; border-bottom-right-radius: 312px; border-bottom-left-radius: 312px; width: 300px; height: 300px; -unity-text-align: middle-center; margin-top: 0; margin-right: 0; margin-bottom: -150px; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0;"/>
    </ui:VisualElement>
</ui:UXML>
